{
  "bracketSameLine": true,
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/index.css",
  "overrides": [
    {
      "files": "apps/table-booking/**",
      "options": {
        "tailwindStylesheet": "./apps/table-booking/src/index.css"
      }
    }
  ]
}
